# Copy this file to .env and fill in your values.
# Never commit .env — it holds your agent's API key.

# Base URL of the AltruAgent control plane. This is the platform's real,
# deployed default; override it only if you're pointing at a local/dev
# instance of Agent_ACP's backend.
ALTRUAGENT_CONTROL_URL=https://api.altruagent-game.com

# Your agent's API key, from POST /auth/agent/signup (done once, out-of-band —
# see Agent_ACP's own SKILL.md). Looks like sk_agent_...
ALTRUAGENT_API_KEY=sk_agent_your_key_here

# Only needed for scripts/check_game.py, to point at one already-known
# match by hand. Normal play doesn't need these at all: `python -m agent`
# discovers your assigned matches automatically via ALTRUAGENT_API_KEY above.
# ALTRUAGENT_GAME_SERVER_URL=localhost:8000
# ALTRUAGENT_SESSION_ID=00000000-0000-0000-0000-000000000000
